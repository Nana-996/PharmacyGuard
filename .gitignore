# ==============================================================================
# PharmacyGuard .gitignore
# ==============================================================================

# Python & Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env.local
*.pem
*.key
*.token

# Local SQLite Databases (Created at runtime via initialize_database)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Logs
logs/
*.log

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
