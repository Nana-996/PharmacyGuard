# ==============================================================================
# PharmacyGuard Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Amazon Bedrock Model Configuration (Strands Agent Engine)
# ------------------------------------------------------------------------------
# Provide an AWS Bedrock API Key / Bearer Token for local evaluation:
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here

# AWS Region where your Bedrock model access is active:
AWS_DEFAULT_REGION=us-east-1

# Bedrock Foundation Model Identifier
# Supported Claude Sonnet model in us-east-1:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Security & JWT Session Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing stateless authentication JWTs.
# If omitted or left blank, an ephemeral 256-bit CSPRNG secret is generated per process:
JWT_SECRET_KEY=pharmacyguard-dev-secret-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Allowed CORS origins (comma-separated):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Server & Environment Configuration
# ------------------------------------------------------------------------------
# Deployment mode reported by /health (e.g. competition_demo, production, staging, local_development):
ENVIRONMENT=competition_demo
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# Competition Demo Safety & Rate Limiting Guardrails
# ------------------------------------------------------------------------------
# Enable sliding-window IP rate limiter & session AI quotas for public demos:
DEMO_RATE_LIMIT_ENABLED=true
# Maximum general HTTP requests per minute per IP:
DEMO_MAX_REQ_PER_MINUTE=60
# Maximum Bedrock AI clinical verification runs per session / IP:
DEMO_MAX_AGENT_CALLS_PER_SESSION=20
# Prevent arbitrary patient health information entry (synthetic only):
DEMO_RESTRICT_ARBITRARY_PATIENTS=true
