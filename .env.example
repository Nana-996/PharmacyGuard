# ==============================================================================
# PharmacyGuard Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Amazon Bedrock Model Configuration (Strands Agent Engine)
# ------------------------------------------------------------------------------
# Provide an AWS Bedrock API Key / Bearer Token for local evaluation:
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here

# AWS Region where your Bedrock model access is active:
AWS_DEFAULT_REGION=us-east-1

# Bedrock Foundation Model Identifier
# Supported Claude Sonnet model in us-east-1:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# ------------------------------------------------------------------------------
# Security & JWT Session Configuration
# ------------------------------------------------------------------------------
# Secret key used for signing stateless authentication JWTs.
# If omitted or left blank, an ephemeral 256-bit CSPRNG secret is generated per process:
JWT_SECRET_KEY=pharmacyguard-dev-secret-key-2026-hackathon
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Allowed CORS origins (comma-separated):
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Local Server Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
